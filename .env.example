# Copy to .env.local (git-ignored) and adjust. EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
#
# BURAK backend base URL, without a trailing slash:
#   iOS simulator / web:   http://localhost:3003
#   Android emulator:      http://10.0.2.2:3003
#   Physical device:       http://<your-computer-LAN-IP>:3003
#   Production:            https://<your-domain>  (release builds block plain http)
EXPO_PUBLIC_API_URL=http://localhost:3003
